{
  "name": "yasrab-erp",
  "version": "1.0.0",
  "description": "Yasrab Education ERP System - Full Stack Application",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "NODE_ENV=development node backend/server.js",
    "prod": "NODE_ENV=production node backend/server.js",
    "test": "echo \"Test suite coming soon\" && exit 0",
    "docker:build": "docker build -t yasrab-erp:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env yasrab-erp:latest",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "db:backup": "cp backend/db.json backend/db.backup.$(date +%Y%m%d_%H%M%S).json",
    "db:reset": "rm -f backend/db.json && npm start"
  },
  "keywords": [
    "erp",
    "education",
    "management",
    "system",
    "school"
  ],
  "author": "Yasrab Development Team",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.0.3"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/yasrab-erp.git"
  }
}
